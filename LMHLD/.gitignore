# ── 备份仓库专用 .gitignore（2026-09-22 建立）────────────────
# 目的：让本目录成为一个"代码与实验记录"的版本控制仓库，
#       以便任何改动都可精确回滚（git checkout -- <file> / git reset --hard <tag>）。
# 原则：只跟踪源码与文本记录；权重、数据集、生成图、缓存一律排除。

# ── 模型权重（体积大且本轮不会被修改）──────────────────────
models_prior/
*.pth
*.pt
*.onnx
*.bin
*.safetensors

# ── Python 缓存与环境 ─────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── IDE ──────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── 运行产物 / 临时目录 ───────────────────────────────────
temp_images/
uploads/
yolo_out/
*.log

# ── 大型二进制产物（图表另存于 D:\竞赛材料，文本记录仍跟踪）──
*.npy
experiments/**/*.png
demo_*.png

# ── 本地编辑器备份 ────────────────────────────────────────
*.swp
*~
